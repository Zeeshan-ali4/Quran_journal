#!/usr/bin/env python3
"""CSIL Phase 3A: assemble existing editable asset PPTX slides into a new PPTX.

Windows PowerPoint desktop + pywin32 required for assembly. Dry-run works without them.
Examples:
  py src/csil_assemble_deck.py --ids AST-AAAA AST-BBBB --dry-run
  py src/csil_assemble_deck.py --ids AST-AAAA AST-BBBB --title "Pilot deck"
  py src/csil_assemble_deck.py --selection selected_assets.txt --output output/my_deck.pptx

Each asset PPTX is inserted as a native PowerPoint slide (not rasterized).
No source PPTX files are modified. Review slide size, theme, fonts, links, and editability.
"""
import argparse
import csv
import json
import re
import sys
from datetime import datetime
from pathlib import Path

ID_RE = re.compile(r'^AST-[A-Za-z0-9_-]+$', re.I)
PP_PPTX = 24


def parse_selection(path):
    if path.suffix.lower() == '.json':
        obj = json.loads(path.read_text(encoding='utf-8-sig'))
        if isinstance(obj, dict):
            obj = obj.get('asset_ids', obj.get('ids', obj.get('assets', [])))
        if not isinstance(obj, list):
            raise ValueError('JSON selection must be a list or an object with asset_ids/ids/assets list')
        return [str(x.get('asset_id', x.get('id', '')) if isinstance(x, dict) else x).strip() for x in obj]
    if path.suffix.lower() == '.csv':
        with path.open(encoding='utf-8-sig', newline='') as f:
            rows = csv.DictReader(f)
            if not rows.fieldnames:
                raise ValueError('CSV must have an asset_id or id header')
            col = next((x for x in rows.fieldnames if x.strip().lower() in ('asset_id', 'id')), None)
            if col is None:
                raise ValueError('CSV must have an asset_id or id column')
            return [str(row.get(col, '')).strip() for row in rows]
    return [line.strip() for line in path.read_text(encoding='utf-8-sig').splitlines()
            if line.strip() and not line.lstrip().startswith('#')]


def check_assets(ids, library):
    if not ids:
        raise ValueError('No asset IDs provided. Use --ids or --selection.')
    for aid in ids:
        if not ID_RE.fullmatch(aid):
            raise ValueError(f'Invalid asset ID: {aid!r}. Expected AST-...')
    entries = []
    for aid in ids:
        p = library / 'assets' / (aid + '.pptx')
        if not p.is_file():
            raise FileNotFoundError(f'Editable asset missing: {p}')
        entries.append((aid, p.resolve()))
    return entries


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    choice = ap.add_mutually_exclusive_group(required=True)
    choice.add_argument('--ids', nargs='+', metavar='AST-ID', help='Asset IDs in desired slide order')
    choice.add_argument('--selection', type=Path, help='TXT (one ID per line), CSV (asset_id column), or JSON')
    ap.add_argument('--library', type=Path, default=Path('output/asset_library'))
    ap.add_argument('--output', type=Path, help='Output PPTX path; default is timestamped in output/assembled_decks')
    ap.add_argument('--title', default='', help='Deck title stored in PowerPoint document properties')
    ap.add_argument('--dry-run', action='store_true', help='Validate and print plan; do not start PowerPoint')
    args = ap.parse_args()
    try:
        ids = args.ids if args.ids is not None else parse_selection(args.selection)
        entries = check_assets(ids, args.library.resolve())
    except (ValueError, OSError, json.JSONDecodeError) as e:
        ap.error(str(e))
    out = (args.output or Path('output/assembled_decks') /
           ('CSIL_assembled_' + datetime.now().strftime('%Y%m%d_%H%M%S') + '.pptx')).resolve()
    if out.suffix.lower() != '.pptx':
        ap.error('--output must end in .pptx')
    if out.exists():
        ap.error(f'Refusing to overwrite existing file: {out}')
    print(f'Assets selected: {len(entries)}')
    for i, (aid, p) in enumerate(entries, 1):
        print(f'  {i}. {aid} -> {p.name}')
    print(f'Output: {out}')
    if args.dry_run:
        print('Dry run complete. No PowerPoint file created.')
        return 0

    try:
        import pythoncom
        import win32com.client
    except ImportError:
        print('ERROR: Windows PowerPoint assembly requires pywin32 (py -m pip install pywin32).', file=sys.stderr)
        return 2

    out.parent.mkdir(parents=True, exist_ok=True)
    pythoncom.CoInitialize()
    deck = None
    inserted = []
    try:
        app = win32com.client.Dispatch('PowerPoint.Application')
        deck = app.Presentations.Add(WithWindow=-1)
        # A new presentation may contain an initial slide depending on template settings.
        while deck.Slides.Count:
            deck.Slides(1).Delete()
        # Match the first asset's slide dimensions. Others are checked for mismatch.
        first = app.Presentations.Open(str(entries[0][1]), ReadOnly=-1, Untitled=0, WithWindow=-1)
        try:
            width = float(first.PageSetup.SlideWidth)
            height = float(first.PageSetup.SlideHeight)
        finally:
            first.Close()
        deck.PageSetup.SlideWidth = width
        deck.PageSetup.SlideHeight = height
        for index, (aid, source_path) in enumerate(entries, 1):
            src = app.Presentations.Open(str(source_path), ReadOnly=-1, Untitled=0, WithWindow=-1)
            try:
                sw, sh = float(src.PageSetup.SlideWidth), float(src.PageSetup.SlideHeight)
                if abs(sw-width)>0.5 or abs(sh-height)>0.5:
                    raise RuntimeError(f'{aid} slide size differs from first asset ({sw:.1f}x{sh:.1f} vs {width:.1f}x{height:.1f} points). Stopping to avoid distortion.')
                source_count = int(src.Slides.Count)
                if source_count < 1:
                    raise RuntimeError(f'{aid} contains no slides')
                # InsertFromFile imports native slides, including editable PowerPoint objects.
                # All source slides are imported (normally one per extracted asset).
                start_count = int(deck.Slides.Count)
                added = int(deck.Slides.InsertFromFile(str(source_path), start_count, 1, source_count))
                if added != source_count:
                    raise RuntimeError(f'{aid}: expected {source_count} slides, inserted {added}')
                native_counts = [int(deck.Slides(start_count+j).Shapes.Count) for j in range(1, added+1)]
                inserted.append({'asset_id': aid, 'source_pptx': str(source_path),
                                 'slides_added': added, 'native_top_level_shapes': native_counts})
                print(f'[{index}/{len(entries)}] {aid}: inserted {added} editable slide(s), shape counts {native_counts}', flush=True)
            finally:
                src.Close()
        if args.title:
            try:
                deck.BuiltInDocumentProperties('Title').Value = args.title
            except Exception:
                print('Warning: Could not set document title property.')
        deck.SaveAs(str(out), PP_PPTX)
        print(f'SAVED: {out}')
    except Exception as e:
        print(f'ERROR: {e}', file=sys.stderr)
        print('No completed deck saved; check the selected assets and retry.', file=sys.stderr)
        return 1
    finally:
        if deck is not None:
            try:
                deck.Close()
            except Exception:
                pass
        pythoncom.CoUninitialize()
    report = out.with_suffix('.assembly.json')
    report.write_text(json.dumps({'output':str(out),'title':args.title,
                                  'total_slides':sum(x['slides_added'] for x in inserted),
                                  'assets':inserted,
                                  'review_required':['Inspect visual fidelity and slide order',
                                                     'Verify native shape/text editability in PowerPoint',
                                                     'Check fonts, theme, external links, and accessibility']},
                                 indent=2), encoding='utf-8')
    print(f'Report: {report}')
    return 0

if __name__ == '__main__':
    sys.exit(main())
