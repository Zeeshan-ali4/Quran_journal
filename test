#!/usr/bin/env python3
"""CSIL Phase 2: offline searchable preview gallery + relevance evaluation.
Reads existing smart classifier catalogue; writes a self-contained HTML index.
No external packages, AI calls, network services, or changes to source assets.
"""
import argparse, json, html, re
from pathlib import Path

SYNONYMS = {
 'roadmap':['timeline','milestone','implementation','phases','plan'],
 'timeline':['roadmap','milestone','sequence','phases'],
 'funnel':['conversion','pipeline','stages','filter'],
 'matrix':['grid','quadrant','2x2','framework'],
 'journey':['customer','experience','touchpoint','process'],
 'process':['workflow','steps','flow','journey'],
 'strategy':['strategic','framework','priorities','transformation'],
 'operating':['operations','organisation','organization','model'],
 'pyramid':['hierarchy','layers','levels'],
 'comparison':['compare','versus','table','matrix'],
 'organisation':['organization','org','structure','hierarchy'],
 'transformation':['change','roadmap','implementation','strategy'],
 'kpi':['metric','performance','dashboard','indicator'],
}

def clean(v):
    if v is None: return ''
    if isinstance(v,list): return ' '.join(clean(x) for x in v)
    if isinstance(v,dict): return ' '.join(clean(x) for x in v.values())
    return str(v)

def main():
    ap=argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--library',type=Path,default=Path('output/asset_library'))
    args=ap.parse_args()
    root=args.library.resolve()
    src=root/'ollama_classifications_smart'/'catalogue_ollama_enriched.json'
    if not src.exists(): ap.error(f'Missing {src}. Run: py ./src/csil_smart_classifier.py --plan')
    data=json.loads(src.read_text(encoding='utf-8-sig'))
    if not isinstance(data,dict) or not isinstance(data.get('assets'),list): ap.error('Expected assets list')
    dest=root/'search_pilot'; dest.mkdir(parents=True,exist_ok=True)
    items=[]; missing=0
    for a in data['assets']:
        c=a.get('ollama_classification')
        if not isinstance(c,dict): continue
        aid=str(a.get('asset_id',''))
        if not re.fullmatch(r'[A-Za-z0-9_-]+',aid): continue
        png=root/'previews'/(aid+'.png')
        ppt=root/'assets'/(aid+'.pptx')
        if not png.is_file(): missing+=1; continue
        def val(key): return clean(c.get(key,''))
        origin=clean(a.get('classification_origin',''))
        item={
            'id':aid,'name':val('asset_name') or aid,'type':val('asset_type'),
            'category':clean(a.get('asset_category') or a.get('asset_type')),
            'description':val('description'),'visual':val('visual_structure'),
            'intent':val('communication_intent'),'framework':val('consulting_framework'),
            'uses':clean(c.get('consulting_use_cases')),'keywords':clean(c.get('search_keywords')),
            'slide_text':clean(a.get('extracted_text'))[:2500],
            'confidence':c.get('confidence',0),'review':bool(c.get('requires_human_review')),
            'origin':origin,'deck':clean(a.get('source_deck')),'slide':clean(a.get('source_slide')),
            'preview':'../previews/'+aid+'.png',
            'pptx':'../assets/'+aid+'.pptx' if ppt.is_file() else '',
        }
        items.append(item)
    items.sort(key=lambda x:x['id'])
    # JSON is embedded as a JS literal, not fetched: file:// works offline.
    payload=json.dumps(items,ensure_ascii=False).replace('<','\\u003c').replace('>','\\u003e').replace('&','\\u0026')
    syn=json.dumps(SYNONYMS,ensure_ascii=False)
    page=r'''<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSIL — Search Pilot</title><style>
:root{font-family:Segoe UI,Arial,sans-serif;color:#1c2633;background:#f5f7fa}*{box-sizing:border-box}body{margin:0}
header{background:#14243a;color:white;padding:22px max(24px,calc((100vw - 1300px)/2))}header h1{margin:0 0 6px;font-size:24px}header p{margin:0;color:#d0dae6;font-size:14px}
main{max-width:1300px;margin:auto;padding:24px}.tools{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:14px;align-items:center}
input,select,button{font:inherit;padding:10px 12px;border:1px solid #ccd4df;border-radius:8px;background:white}
input{min-width:260px;flex:1}button{cursor:pointer}button:hover{background:#e8eef5}.muted{color:#657386;font-size:13px}
.stats{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:15px}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
.card{background:white;border:1px solid #e0e6ee;border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
.thumb{width:100%;aspect-ratio:16/9;object-fit:contain;background:#eef2f7;border-bottom:1px solid #e0e6ee}
.content{padding:15px;display:flex;flex-direction:column;gap:9px;flex:1}.name{font-weight:700;font-size:16px;line-height:1.35}
.desc{font-size:13px;line-height:1.45}.tag{display:inline-block;border-radius:5px;background:#eef2f7;padding:4px 7px;font-size:11px;color:#42536a}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:auto}.actions a{padding:7px 9px;border:1px solid #cbd5e1;border-radius:6px;text-decoration:none;color:#13529b;font-size:12px}
.eval{border-top:1px solid #e7ebf0;padding-top:8px;display:flex;align-items:center;gap:7px}.eval button{padding:5px 8px;font-size:12px}
.active{background:#d5e9ff!important;border-color:#337bc1!important}.note{font-size:12px;color:#59677b}
</style></head><body><header><h1>CSIL — Consulting Asset Search Pilot</h1><p>Local-only preview gallery · AI-classified assets · Search and relevance testing</p></header>
<main><div class="tools"><input id="q" type="search" placeholder="Try: five stage roadmap, operating model, customer journey…" autofocus>
<select id="category"><option value="">All categories</option></select>
<label><input id="onlypptx" type="checkbox" checked style="min-width:0"> Editable PPTX only</label>
<select id="sort"><option value="relevance">Sort: Relevance</option><option value="confidence">Sort: Confidence</option></select>
<button id="export">Export evaluation CSV</button></div>
<div class="stats"><span id="count"></span><span class="muted">Rate results as Relevant / Not relevant; export your test ratings.</span></div>
<div class="cards" id="cards"></div></main>
<script>
const ITEMS=__DATA__;const SYN=__SYN__;
const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const tokens=s=>(String(s||'').toLowerCase().match(/[a-z0-9]+/g)||[]).filter(w=>w.length>1);
const cats=[...new Set(ITEMS.map(x=>x.category).filter(Boolean))].sort();cats.forEach(x=>{let o=document.createElement('option');o.value=x;o.textContent=x;$('category').appendChild(o)});
const ratings=[];
function score(x,q){let words=tokens(q);if(!words.length)return 0;
 const fields=[[x.name,6],[x.visual,5],[x.framework,5],[x.intent,4],[x.uses,4],[x.keywords,4],[x.description,2],[x.type,2],[x.category,2],[x.slide_text,1]];
 let sum=0;const qlower=q.toLowerCase().trim();for(let [field,w] of fields){let text=String(field||'').toLowerCase();if(!text)continue;
 if(qlower.length>3&&text.includes(qlower))sum+=w*4;
 let ts=new Set(tokens(text));for(let word of words){if(ts.has(word))sum+=w;else if(word.length>4&&[...ts].some(t=>t.startsWith(word)||word.startsWith(t)&&t.length>3))sum+=w*.55;
 for(let alias of (SYN[word]||[]))if(text.includes(alias))sum+=w*.35;}}
 return sum;
}
function render(){let q=$('q').value.trim(),cat=$('category').value,only=$('onlypptx').checked;
 let list=ITEMS.filter(x=>(!cat||x.category===cat)&&(!only||x.pptx)).map(x=>({...x,rank:score(x,q)}));
 if(q)list=list.filter(x=>x.rank>0);
 if($('sort').value==='confidence')list.sort((a,b)=>(Number(b.confidence)||0)-(Number(a.confidence)||0));
 else list.sort((a,b)=>b.rank-a.rank||(Number(b.confidence)||0)-(Number(a.confidence)||0));
 $('count').textContent=`${list.length} results from ${ITEMS.length} AI-classified assets`;
 $('cards').innerHTML=list.slice(0,60).map((x,i)=>`<article class="card"><img class="thumb" src="${esc(x.preview)}" alt="Preview of ${esc(x.name)}" loading="lazy">
 <div class="content"><div class="name">${esc(x.name)}</div><div><span class="tag">${esc(x.category||x.type)}</span> <span class="tag">Confidence: ${esc(x.confidence)}</span>${x.review?' <span class="tag">Review needed</span>':''}</div>
 <div class="desc">${esc(x.description)}</div><div class="note"><b>Visual:</b> ${esc(x.visual)}</div><div class="note"><b>Use cases:</b> ${esc(x.uses)}</div>
 <div class="note">${esc(x.id)} · ${esc(x.deck)}${x.slide?' · Slide '+esc(x.slide):''}</div>
 <div class="actions"><a href="${esc(x.preview)}" target="_blank">View preview</a>${x.pptx?`<a href="${esc(x.pptx)}">Open editable PPTX</a>`:'<span class="note">PPTX unavailable</span>'}</div>
 <div class="eval"><span class="note">Relevance:</span><button data-id="${esc(x.id)}" data-r="relevant">Relevant</button><button data-id="${esc(x.id)}" data-r="not_relevant">Not relevant</button></div></div></article>`).join('')||'<p>No matching classified assets. Try fewer or different keywords.</p>';
 document.querySelectorAll('.eval button').forEach(b=>b.addEventListener('click',()=>{let id=b.dataset.id,r=b.dataset.r,query=$('q').value.trim();ratings.push({query,asset_id:id,rating:r,recorded_at:new Date().toISOString()});b.parentElement.querySelectorAll('button').forEach(z=>z.classList.toggle('active',z===b));}));
}
['q','category','onlypptx','sort'].forEach(id=>$(id).addEventListener('input',render));
$('export').addEventListener('click',()=>{if(!ratings.length){alert('Rate at least one result first.');return;}const columns=['query','asset_id','rating','recorded_at'];let csv=[columns.join(','),...ratings.map(r=>columns.map(k=>'"'+String(r[k]||'').replace(/"/g,'""')+'"').join(','))].join('\r\n');let url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));let a=document.createElement('a');a.href=url;a.download='csil_search_evaluation.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
render();</script></body></html>'''
    page=page.replace('__DATA__',payload).replace('__SYN__',syn)
    target=dest/'index.html';target.write_text(page,encoding='utf-8')
    print(f'Indexed {len(items)} AI-classified assets; {missing} missing previews.')
    print('Open in browser:',target)
    print('Search is local keyword/synonym ranking, NOT embedding-based semantic search.')
    print('Evaluate with relevant/not relevant buttons and Export evaluation CSV.')

if __name__=='__main__':main()
