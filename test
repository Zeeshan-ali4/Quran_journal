def serve(root, port, timeout, chat_model):
    """Expose search, immutable asset downloads and serialized COM assembly on loopback."""
    import subprocess
    import threading
    import uuid
    from urllib.parse import quote

    root = root.resolve()
    idx = root / 'semantic_search' / 'index.json'
    if not idx.is_file():
        raise FileNotFoundError(f'Missing {idx}. Run --build first.')
    data = json.loads(idx.read_text(encoding='utf-8'))
    model, items = data['model'], data['items']
    by_id = {x['id']: x for x in items if re.fullmatch(r'AST-[A-Za-z0-9_-]+', str(x.get('id','')))}
    if len(by_id) == 0:
        raise ValueError('The search index contains no valid AST asset IDs.')
    script = Path(__file__).resolve().with_name('csil_assemble_deck_fixed.py')
    if not script.is_file():
        raise FileNotFoundError(f'Assembler not found beside this script: {script}')
    project = root.parent
    out_dir = (project / 'assembled_decks').resolve()
    assemble_lock = threading.Lock()
    storyline_lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        def send(self, body, typ='application/json; charset=utf-8', status=200, extra=None):
            if isinstance(body, str): body = body.encode('utf-8')
            self.send_response(status)
            self.send_header('Content-Type', typ)
            self.send_header('Content-Length', str(len(body)))
            self.send_header('X-Content-Type-Options', 'nosniff')
            self.send_header('Cache-Control', 'no-store')
            self.send_header('Referrer-Policy', 'no-referrer')
            if extra: self.send_header(*extra)
            self.end_headers()
            try: self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError): pass

        def error(self, message, status=400):
            self.send(json.dumps({'error': str(message)}, ensure_ascii=False), status=status)

        def read_json(self):
            if self.headers.get('Content-Type', '').split(';',1)[0].lower() != 'application/json':
                raise ValueError('Expected application/json')
            length = int(self.headers.get('Content-Length', '0'))
            if not 0 < length <= 20000: raise ValueError('Request body must be 1–20000 bytes')
            obj = json.loads(self.rfile.read(length))
            if not isinstance(obj, dict): raise ValueError('Request must be a JSON object')
            return obj

        def do_GET(self):
            path = urlparse(self.path).path
            if path == '/': return self.send(PAGE, 'text/html; charset=utf-8')
            m = re.fullmatch(r'/(preview|pptx)/([A-Za-z0-9_-]+)', path)
            if m:
                kind, aid = m.groups()
                if aid not in by_id: return self.error('Not found', 404)
                folder = 'previews' if kind == 'preview' else 'assets'
                ext = '.png' if kind == 'preview' else '.pptx'
                p = (root / folder / (aid + ext)).resolve()
                if not p.is_relative_to((root / folder).resolve()) or not p.is_file():
                    return self.error('File not found', 404)
                typ = 'image/png' if kind == 'preview' else 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
                extra = None if kind == 'preview' else ('Content-Disposition', f'attachment; filename="{aid}.pptx"')
                return self.send(p.read_bytes(), typ, extra=extra)
            m = re.fullmatch(r'/generated/(CSIL_[a-f0-9]{32})\.(pptx|assembly\.json)', path)
            if m:
                stem, ext = m.groups()
                p = (out_dir / (stem + '.' + ext)).resolve()
                if not p.is_relative_to(out_dir) or not p.is_file(): return self.error('Generated file not found', 404)
                typ = 'application/json' if ext == 'assembly.json' else 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
                extra = ('Content-Disposition', f'attachment; filename="{p.name}"')
                return self.send(p.read_bytes(), typ, extra=extra)
            return self.error('Not found', 404)

        def do_POST(self):
            # Browser-origin checks reduce cross-site triggering of a local COM process.
            host = self.headers.get('Host','')
            if host not in (f'127.0.0.1:{port}', f'localhost:{port}'):
                return self.error('Invalid Host header', 403)
            origin = self.headers.get('Origin')
            if origin and origin not in (f'http://127.0.0.1:{port}', f'http://localhost:{port}'):
                return self.error('Cross-origin request blocked', 403)
            if self.path not in ('/api/search', '/api/assemble', '/api/brief', '/api/recommend'): return self.error('Not found', 404)
            try:
                req = self.read_json()
                if self.path == '/api/brief':
                    brief = req.get('brief')
                    count = req.get('slide_count')
                    if not isinstance(brief,str) or not 20 <= len(brief.strip()) <= 5000:
                        raise ValueError('Brief must be 20–5000 characters')
                    if type(count) is not int or not 3 <= count <= 12:
                        raise ValueError('Slide count must be 3–12')
                    if not storyline_lock.acquire(blocking=False):
                        return self.error('Another storyline generation is running',409)
                    try:
                        result = generate_storyline(brief.strip(), count, chat_model, max(180,timeout))
                    finally:
                        storyline_lock.release()
                    return self.send(json.dumps(result,ensure_ascii=False))
                if self.path == '/api/recommend':
                    slides = req.get('slides')
                    if not isinstance(slides,list) or not 3 <= len(slides) <= 12:
                        raise ValueError('Provide 3–12 storyline slides')
                    validated=[]
                    for s in slides:
                        if not isinstance(s,dict): raise ValueError('Invalid slide')
                        fields={}
                        for key in ('title','purpose','search_query'):
                            v=s.get(key)
                            if not isinstance(v,str) or not 1 <= len(v.strip()) <= 400:
                                raise ValueError(f'Invalid slide {key}')
                            fields[key]=v.strip()
                        fields['key_message']=str(s.get('key_message',''))[:400]
                        validated.append(fields)
                    rerank=req.get('ai_rerank',False)
                    if type(rerank) is not bool:raise ValueError('ai_rerank must be boolean')
                    matched,warnings=suggest_assets(validated,items,model,timeout,root,rerank=rerank,chat_model=chat_model)
                    return self.send(json.dumps({'recommendations':matched,'warnings':warnings},ensure_ascii=False))
                if self.path == '/api/search':
                    q = str(req.get('query','')).strip()[:1000]
                    if not q: raise ValueError('Empty query')
                    mode = req.get('mode','semantic')
                    limit = min(50, max(1, int(req.get('limit',30))))
                    if mode == 'semantic':
                        v = embed(q, model, timeout)
                        scored = [(cosine(v,x['vector']), x) for x in items]
                    elif mode == 'keyword':
                        words = set(re.findall(r'[a-z0-9]+',q.lower()))
                        scored = []
                        for x in items:
                            fields = ' '.join(clean(x.get(k,'')) for k in ('name','description','visual','intent','framework','uses','keywords','slide_text')).lower()
                            tokens = set(re.findall(r'[a-z0-9]+',fields))
                            score = len(words & tokens)/max(len(words),1) + (0.2 if q.lower() in fields else 0)
                            scored.append((score,x))
                    else: raise ValueError('Unknown search mode')
                    scored.sort(key=lambda t:t[0],reverse=True)
                    results = [{k:v for k,v in x.items() if k!='vector'}|{'score':round(s,4)} for s,x in scored[:limit]]
                    return self.send(json.dumps({'model':model,'mode':mode,'total':len(items),'results':results},ensure_ascii=False))

                ids = req.get('asset_ids')
                if not isinstance(ids,list) or not ids: raise ValueError('Select at least one asset')
                if len(ids)>100: raise ValueError('Maximum 100 assets per deck')
                if not all(isinstance(a,str) and re.fullmatch(r'AST-[A-Za-z0-9_-]+',a) for a in ids):
                    raise ValueError('Invalid asset ID; expected AST-...')
                if len(ids)!=len(set(ids)): raise ValueError('Duplicate asset IDs are not allowed')
                for aid in ids:
                    if aid not in by_id: raise ValueError(f'Asset not in search catalogue: {aid}')
                    p = (root/'assets'/(aid+'.pptx')).resolve()
                    if not p.is_relative_to((root/'assets').resolve()) or not p.is_file():
                        raise ValueError(f'Editable PPTX missing: {aid}')
                title = req.get('title','')
                if not isinstance(title,str) or len(title)>160 or any(ord(c)<32 for c in title):
                    raise ValueError('Title must be plain text of at most 160 characters')
                if not assemble_lock.acquire(blocking=False):
                    return self.error('Another deck assembly is already running. Try again after it finishes.',409)
                try:
                    # Random server-generated basename; no user-controlled output paths.
                    stem = 'CSIL_' + uuid.uuid4().hex
                    out = out_dir / (stem + '.pptx')
                    cmd = [sys.executable, str(script), '--ids', *ids, '--library', str(root),
                           '--output', str(out), '--title', title]
                    result = subprocess.run(cmd, cwd=str(project), capture_output=True,
                                            text=True, errors='replace', timeout=900, shell=False)
                    report = out.with_suffix('.assembly.json')
                    if result.returncode != 0 or not out.is_file() or not report.is_file():
                        detail = (result.stderr or result.stdout or 'No output from assembler').strip()
                        return self.error('PowerPoint assembly failed: ' + detail[-3000:], 500)
                    info = json.loads(report.read_text(encoding='utf-8'))
                    return self.send(json.dumps({'asset_count':len(ids),'total_slides':info.get('total_slides',0),
                                      'pptx_url':'/generated/'+stem+'.pptx',
                                      'report_url':'/generated/'+stem+'.assembly.json'}))
                except subprocess.TimeoutExpired:
                    return self.error('PowerPoint assembly exceeded 15 minutes. Check PowerPoint for dialogs; inspect output folder before retrying.',504)
                finally:
                    assemble_lock.release()
            except (ValueError, TypeError, json.JSONDecodeError) as e:
                return self.error(str(e),400)
            except Exception as e:
                print(f'CSIL server error: {e}', file=sys.stderr)
                return self.error('Unexpected server error. See server terminal for details.',500)

    server = ThreadingHTTPServer(('127.0.0.1',port),Handler)
    print(f'CSIL Phase 3C.3 gallery: http://127.0.0.1:{port}/ (Ctrl+C to stop)')
    try: server.serve_forever()
    except KeyboardInterrupt: pass
    finally: server.server_close()

def main():
    ap=argparse.ArgumentParser(description=__doc__)
    group=ap.add_mutually_exclusive_group(required=True)
    group.add_argument('--build',action='store_true',help='Generate/reuse local embeddings')
    group.add_argument('--serve',action='store_true',help='Run local browser search')
    ap.add_argument('--library',type=Path,default=Path('output/asset_library'))
    ap.add_argument('--model',default=MODEL)
    ap.add_argument('--chat-model',default='qwen3:14b',help='Local Ollama chat model for storyline generation')
    ap.add_argument('--port',type=int,default=8765)
    ap.add_argument('--timeout',type=int,default=180)
    args=ap.parse_args();root=args.library.resolve()
    if args.build:build(root,args.model,args.timeout)
    else:serve(root,args.port,args.timeout,args.chat_model)
if __name__=='__main__':main()
