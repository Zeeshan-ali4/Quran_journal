#!/usr/bin/env python3
"""CSIL Phase 1.5: local, rule-based catalogue enrichment and quality triage.
Standard library only. No network calls; source PPTX files are read-only.
"""
import argparse, csv, hashlib, json, re, zipfile
from collections import Counter, defaultdict
from pathlib import Path
from xml.etree import ElementTree as ET

NS={"a":"http://schemas.openxmlformats.org/drawingml/2006/main",
    "p":"http://schemas.openxmlformats.org/presentationml/2006/main"}
RULES={
 "communication_intent":{
  "sequence":["roadmap","timeline","phase","step","journey","milestone","implementation","process"],
  "compare":["compare","comparison","versus","vs","option","alternative","benchmark"],
  "prioritise":["priority","prioritization","prioritisation","impact","effort","matrix","ranking"],
  "diagnose":["root cause","issue","gap","assessment","diagnostic","current state","maturity"],
  "quantify":["revenue","cost","profit","growth","kpi","metric","financial","percent","performance"],
  "govern":["governance","operating model","accountability","raci","committee","decision rights"],
  "summarise":["summary","overview","key takeaways","executive summary","at a glance"]},
 "consulting_use_case":{
  "transformation":["transformation","change management","future state","target state","roadmap"],
  "strategy":["strategy","strategic","market","competitive","growth","portfolio"],
  "operating_model":["operating model","organisation","organization","capability","process","raci"],
  "delivery":["delivery","implementation","project","programme","program","milestone","workstream"],
  "governance":["governance","risk","control","compliance","accountability"],
  "finance":["financial","revenue","cost","margin","investment","budget"]},
 "visual_structure":{
  "timeline":["timeline","roadmap","milestone","journey"],
  "matrix":["matrix","quadrant","2x2","2 x 2"],
  "funnel":["funnel","pipeline"],
  "hierarchy":["hierarchy","org chart","organisation chart","tree"],
  "process_flow":["process","workflow","phase","step","stage"],
  "dashboard":["dashboard","scorecard","kpi","metrics"],
  "cycle":["cycle","circular","wheel"]}}
def read_pptx(path):
    """Inspect editable package for counts and text; never executes macros."""
    info={"text":"","shape_count":0,"group_count":0,"picture_count":0,
          "chart_refs":0,"table_count":0,"readable":False,"package_error":""}
    try:
        with zipfile.ZipFile(path) as z:
            slide_names=[n for n in z.namelist() if re.fullmatch(r"ppt/slides/slide\d+\.xml",n)]
            texts=[]
            for name in slide_names:
                root=ET.fromstring(z.read(name))
                texts.extend((e.text or "") for e in root.findall(".//a:t",NS))
                info["shape_count"]+=len(root.findall(".//p:sp",NS))
                info["group_count"]+=len(root.findall(".//p:grpSp",NS))-len(root.findall("./p:cSld/p:spTree/p:grpSp",NS))
                info["picture_count"]+=len(root.findall(".//p:pic",NS))
                info["chart_refs"]+=sum(1 for e in root.iter() if e.tag.endswith("}chart"))
                info["table_count"]+=sum(1 for e in root.iter() if e.tag.endswith("}tbl"))
            info["text"]=" ".join(texts).strip()
            info["readable"]=bool(slide_names)
            if not slide_names: info["package_error"]="No slide XML found"
    except (OSError,zipfile.BadZipFile,ET.ParseError,RuntimeError) as exc:
        info["package_error"]=str(exc)
    return info
def tag(text, group):
    lower=text.lower()
    scores={k:sum(1 for term in terms if term in lower) for k,terms in RULES[group].items()}
    ranked=sorted(((k,v) for k,v in scores.items() if v),key=lambda x:(-x[1],x[0]))
    return [k for k,_ in ranked[:3]]
def resolve_file(root, entry, field, folder, extension):
    raw=entry.get(field)
    candidates=[]
    if raw: candidates.append(Path(raw))
    candidates.append(root/folder/(entry["asset_id"]+extension))
    for q in candidates:
        if q.is_file(): return q.resolve()
    return None
def write_csv(path,rows,fields):
    with path.open("w",encoding="utf-8-sig",newline="") as f:
        w=csv.DictWriter(f,fieldnames=fields,extrasaction="ignore")
        w.writeheader()
        for row in rows:
            w.writerow({k:json.dumps(v,ensure_ascii=False) if isinstance(v,(list,dict)) else v
                        for k,v in row.items()})
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--library",type=Path,default=Path("output/asset_library"))
    ap.add_argument("--review-limit",type=int,default=0,help="0 = all")
    args=ap.parse_args()
    root=args.library.resolve()
    src=root/"catalogue.json"
    if not src.is_file(): ap.error(f"Missing {src}")
    original=json.loads(src.read_text(encoding="utf-8"))
    entries=original.get("assets")
    if not isinstance(entries,list): ap.error("catalogue.json needs an assets array")
    out=[]; exact=defaultdict(list); structural=defaultdict(list)
    for e in entries:
        aid=e.get("asset_id","")
        if not aid: continue
        ppt=resolve_file(root,e,"editable_pptx","assets",".pptx")
        png=resolve_file(root,e,"preview_png","previews",".png")
        stats=read_pptx(ppt) if ppt else {"text":"","shape_count":0,"group_count":0,
            "picture_count":0,"chart_refs":0,"table_count":0,"readable":False,"package_error":"Missing PPTX"}
        text=stats["text"]
        kind=e.get("asset_type","unknown")
        category={"full_slide":"complete_slide","native_group":"native_group",
                  "logical_candidate":"logical_component"}.get(kind,"other")
        file_hash=hashlib.sha256(ppt.read_bytes()).hexdigest() if ppt and stats["readable"] else ""
        # Similarity key is only a review heuristic, not visual equivalence.
        norm=re.sub(r"\s+"," ",re.sub(r"[^a-z0-9 ]"," ",text.lower())).strip()
        signature=hashlib.sha256(json.dumps([category,norm,stats["shape_count"],
            stats["picture_count"],stats["chart_refs"],stats["table_count"]]).encode()).hexdigest()
        record=dict(e)
        record.update(asset_category=category,extracted_text=text[:12000],
            communication_intent=tag(text,"communication_intent"),
            consulting_use_case=tag(text,"consulting_use_case"),
            visual_structure=tag(text,"visual_structure"),
            native_shape_count=stats["shape_count"],native_group_count=stats["group_count"],
            picture_count=stats["picture_count"],chart_reference_count=stats["chart_refs"],
            table_count=stats["table_count"],pptx_exists=bool(ppt),preview_exists=bool(png),
            pptx_readable=stats["readable"],package_error=stats["package_error"],
            sha256=file_hash,structural_signature=signature,
            ai_classified=False,visual_validated=False,editability_validated=False)
        reasons=[]
        if not ppt: reasons.append("missing_pptx")
        elif not stats["readable"]: reasons.append("invalid_or_unreadable_pptx")
        if not png: reasons.append("missing_preview")
        if stats["readable"] and not any(stats[k] for k in
            ("shape_count","picture_count","chart_refs","table_count")):
            reasons.append("empty_or_unsupported_content")
        if kind=="logical_candidate": reasons.append("logical_group_requires_review")
        if not any((record["communication_intent"],record["consulting_use_case"],
                    record["visual_structure"])):
            reasons.append("semantic_tags_unresolved")
        record["review_reasons"]=reasons
        record["quality_gate"]="blocked" if any(x in reasons for x in
            ("missing_pptx","invalid_or_unreadable_pptx","empty_or_unsupported_content")) else "needs_review"
        # Never auto-publish: editable object fidelity must be manually verified.
        record["publication_status"]="draft"
        out.append(record)
        if file_hash: exact[file_hash].append(aid)
        if norm and len(norm)>=20: structural[signature].append(aid)
    pairs=[]
    for kind,groups in (("exact_file",exact),("same_text_and_object_counts",structural)):
        for ids in groups.values():
            if len(ids)>1:
                pairs.append({"duplicate_type":kind,"asset_ids":";".join(sorted(ids)),
                              "count":len(ids),"review_required":True})
    flagged=set()
    for pair in pairs:
        flagged.update(pair["asset_ids"].split(";"))
    for r in out:
        if r["asset_id"] in flagged:
            r["review_reasons"].append("possible_duplicate")
    queue=[r for r in out if r["review_reasons"]]
    queue.sort(key=lambda r:(r["quality_gate"]!="blocked",
              "missing_preview" not in r["review_reasons"],r["asset_id"]))
    if args.review_limit>0: queue=queue[:args.review_limit]
    (root/"catalogue_enriched.json").write_text(json.dumps(
        {"schema_version":"0.5.0","method":"deterministic_rules_no_ai",
         "notes":["No visual understanding or automatic editability certification.",
                  "Duplicates are candidates only; similar content can be intentionally reused."],
         "assets":out},ensure_ascii=False,indent=2),encoding="utf-8")
    cols=["asset_id","source_deck","source_slide","asset_type","asset_category",
          "quality_gate","publication_status","pptx_exists","preview_exists",
          "pptx_readable","native_shape_count","native_group_count","picture_count",
          "chart_reference_count","table_count","communication_intent",
          "consulting_use_case","visual_structure","review_reasons","extracted_text",
          "editable_pptx","preview_png"]
    write_csv(root/"catalogue_enriched.csv",out,cols)
    write_csv(root/"review_queue.csv",queue,cols)
    write_csv(root/"duplicate_candidates.csv",pairs,
              ["duplicate_type","asset_ids","count","review_required"])
    report={"catalogue_records":len(entries),"enriched_records":len(out),
            "pptx_present":sum(r["pptx_exists"] for r in out),
            "preview_present":sum(r["preview_exists"] for r in out),
            "pptx_readable":sum(r["pptx_readable"] for r in out),
            "blocked":sum(r["quality_gate"]=="blocked" for r in out),
            "needs_review":sum(r["quality_gate"]=="needs_review" for r in out),
            "published":0,"review_queue_rows":len(queue),
            "duplicate_candidate_groups":len(pairs),
            "asset_categories":dict(Counter(r["asset_category"] for r in out)),
            "review_reason_counts":dict(Counter(x for r in out for x in r["review_reasons"]))}
    (root/"quality_report.json").write_text(json.dumps(report,indent=2),encoding="utf-8")
    print(json.dumps(report,indent=2))
    print("Wrote catalogue_enriched.json, catalogue_enriched.csv, quality_report.json,")
    print("      duplicate_candidates.csv, review_queue.csv")
if __name__=="__main__": main()
