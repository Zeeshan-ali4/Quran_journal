
$deck = Get-ChildItem ".\input\*.pptx" |
    Select-Object -First 1

$manifest = Get-ChildItem ".\output\*_manifest.json" |
    Select-Object -First 1

$candidates = Get-ChildItem ".\output\*_component_candidates.json" |
    Select-Object -First 1

if (!$deck -or !$manifest -or !$candidates) {
    Write-Host "Missing input files. Check your folders."
} else {
    py .\src\build_asset_library.py `
        $deck.FullName `
        $manifest.FullName `
        $candidates.FullName `
        --output ".\output\asset_library" `
        --threshold 0.55 `
        --max-assets 15
}
