def serve(root,port,timeout):
    idx=root/'semantic_search'/'index.json'
    if not idx.exists():raise FileNotFoundError(f'Missing {idx}. Run --build first.')
    data=json.loads(idx.read_text(encoding='utf-8'))
    model=data['model'];items=data['items'];by_id={x['id']:x for x in items}
    class Handler(BaseHTTPRequestHandler):
        def send(self,body,typ='application/json',status=200,extra=None):
            if isinstance(body,str):body=body.encode('utf-8')
            self.send_response(status);self.send_header('Content-Type',typ);self.send_header('Content-Length',str(len(body)))
            self.send_header('X-Content-Type-Options','nosniff')
            if extra:self.send_header(*extra)
            self.end_headers();self.wfile.write(body)
        def do_GET(self):
            path=urlparse(self.path).path
            if path=='/':return self.send(PAGE,'text/html; charset=utf-8')
            m=re.fullmatch(r'/(preview|pptx)/([A-Za-z0-9_-]+)',unquote(path))
            if not m or m.group(2) not in by_id:return self.send('Not found','text/plain',404)
            kind,aid=m.groups();p=root/('previews' if kind=='preview' else 'assets')/(aid+('.png' if kind=='preview' else '.pptx'))
            if not p.is_file():return self.send('Not found','text/plain',404)
            return self.send(p.read_bytes(),'image/png' if kind=='preview' else 'application/vnd.openxmlformats-officedocument.presentationml.presentation',extra=('Content-Disposition',f'inline; filename="{aid}.pptx"') if kind=='pptx' else None)
        def do_POST(self):
            if self.path!='/api/search':return self.send('{}',status=404)
            try:
                length=int(self.headers.get('Content-Length','0'))
                if length>20000:raise ValueError('Request too large')
                req=json.loads(self.rfile.read(length));q=str(req.get('query','')).strip()[:1000]
                if not q:raise ValueError('Empty query')
                mode=req.get('mode','semantic');limit=min(50,max(1,int(req.get('limit',30))))
                if mode=='semantic':
                    v=embed(q,model,timeout)
                    scored=[(cosine(v,x['vector']),x) for x in items]
                elif mode=='keyword':
                    words=set(re.findall(r'[a-z0-9]+',q.lower()))
                    scored=[]
                    for x in items:
                        fields=' '.join(clean(x.get(k,'')) for k in ('name','description','visual','intent','framework','uses','keywords','slide_text')).lower()
                        tokens=set(re.findall(r'[a-z0-9]+',fields))
                        score=len(words&tokens)/max(len(words),1)+ (0.2 if q.lower() in fields else 0)
                        scored.append((score,x))
                else:raise ValueError('Unknown search mode')
                scored.sort(key=lambda t:t[0],reverse=True)
                results=[{k:v for k,v in x.items() if k!='vector'}|{'score':round(s,4)} for s,x in scored[:limit]]
                self.send(json.dumps({'model':model,'mode':mode,'total':len(items),'results':results},ensure_ascii=False))
            except Exception as e:self.send(json.dumps({'error':str(e)}),status=400)
    server=ThreadingHTTPServer(('127.0.0.1',port),Handler)
    print(f'Local search gallery: http://127.0.0.1:{port}/  (Ctrl+C to stop)')
    try:server.serve_forever()
    except KeyboardInterrupt:pass
    finally:server.server_close()

def main():
    ap=argparse.ArgumentParser(description=__doc__)
    group=ap.add_mutually_exclusive_group(required=True)
    group.add_argument('--build',action='store_true',help='Generate/reuse local embeddings')
    group.add_argument('--serve',action='store_true',help='Run local browser search')
    ap.add_argument('--library',type=Path,default=Path('output/asset_library'))
    ap.add_argument('--model',default=MODEL)
    ap.add_argument('--port',type=int,default=8765)
    ap.add_argument('--timeout',type=int,default=180)
    args=ap.parse_args();root=args.library.resolve()
    if args.build:build(root,args.model,args.timeout)
    else:serve(root,args.port,args.timeout)
if __name__=='__main__':main()
