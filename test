#!/usr/bin/env python3
"""CSIL v2: heuristic logical-component candidates from a v1 PPTX manifest.
Standard library only. Does not modify PowerPoint files.
"""
import argparse, csv, json, math
from pathlib import Path

VISUAL_TYPES = {'shape', 'image', 'connector', 'table', 'chart', 'graphic_frame', 'group'}

def rect(obj):
    g = obj.get('geometry_local') or {}
    vals = [g.get(k) for k in ('x_in','y_in','width_in','height_in')]
    if any(v is None or not isinstance(v, (float,int)) for v in vals): return None
    x,y,w,h = vals
    if w <= 0 or h <= 0: return None
    return (x,y,x+w,y+h)

def gap(a,b):
    dx = max(0, a[0]-b[2], b[0]-a[2])
    dy = max(0, a[1]-b[3], b[1]-a[3])
    return math.hypot(dx,dy)

def bbox(rects):
    return [round(min(r[0] for r in rects),3),round(min(r[1] for r in rects),3),
            round(max(r[2] for r in rects),3),round(max(r[3] for r in rects),3)]

def candidate(slide, objects, reason, score):
    rr=[rect(o) for o in objects if rect(o)]
    return {'slide_number':slide,'candidate_id':f'S{slide}-C{len(objects)}-'+objects[0]['object_key'].split(':')[-1],
            'object_keys':[o['object_key'] for o in objects],
            'object_count':len(objects),'bounds_local_inches':bbox(rr) if rr else None,
            'reason':reason,'heuristic_score':round(score,2),
            'review_required':True}

def detect(slide, threshold):
    result=[]
    # Existing native groups are preserved as separate, higher-confidence candidates.
    def walk(items):
        for o in items:
            if o.get('type')=='group' and len(o.get('children',[]))>=2:
                result.append({'slide_number':slide['slide_number'], 'candidate_id':f"S{slide['slide_number']}-G{o['native_id']}",
                    'object_keys':[o['object_key']], 'object_count':len(o['children']),
                    'bounds_local_inches':list(rect(o)) if rect(o) else None,
                    'reason':'Native PowerPoint group', 'heuristic_score':0.95,'review_required':True})
            walk(o.get('children',[]))
    walk(slide['objects'])
    # Only compare siblings at the slide root. Group children use another coordinate system.
    items=[o for o in slide['objects'] if o.get('type') in VISUAL_TYPES and rect(o)]
    # Exclude likely background shapes covering most of the slide.
    items=[o for o in items if (rect(o)[2]-rect(o)[0])*(rect(o)[3]-rect(o)[1]) < 45]
    n=len(items)
    parent=list(range(n))
    def find(i):
        while parent[i]!=i:
            parent[i]=parent[parent[i]]; i=parent[i]
        return i
    def union(i,j):
        ri,rj=find(i),find(j)
        if ri!=rj:parent[rj]=ri
    for i in range(n):
        for j in range(i+1,n):
            a,b=rect(items[i]),rect(items[j])
            if gap(a,b)<=threshold: union(i,j)
    clusters={}
    for i,o in enumerate(items): clusters.setdefault(find(i),[]).append(o)
    for members in clusters.values():
        if 2<=len(members)<=40:
            # Proximity alone is weak evidence: cap scores deliberately.
            result.append(candidate(slide['slide_number'],members,'Spatial proximity among slide-level objects; not semantic proof',min(0.7,0.35+0.035*len(members))))
    return result

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('manifest',type=Path)
    ap.add_argument('--output',type=Path,default=Path('output'))
    ap.add_argument('--gap',type=float,default=0.12,help='Max edge gap in inches (default 0.12)')
    args=ap.parse_args()
    data=json.loads(args.manifest.read_text(encoding='utf-8'))
    if not isinstance(data.get('slides'),list): ap.error('Not a CSIL v1 manifest')
    args.output.mkdir(parents=True,exist_ok=True)
    candidates=[c for s in data['slides'] for c in detect(s,args.gap)]
    out={'schema_version':'0.2.0','source_manifest':args.manifest.name,
         'method':'Deterministic native grouping + simple spatial clustering',
         'warnings':['Spatial proximity is not semantic understanding. Review all candidates.',
                     'Coordinates are local; nested groups are not spatially clustered.',
                     'Background filtering uses a crude fixed area threshold and may need adjustment.',
                     'No PowerPoint assets are extracted or modified.'],
         'candidates':candidates}
    stem=args.manifest.stem.replace('_manifest','')
    jp=args.output/f'{stem}_component_candidates.json'
    cp=args.output/f'{stem}_component_candidates.csv'
    jp.write_text(json.dumps(out,indent=2,ensure_ascii=False),encoding='utf-8')
    with cp.open('w',encoding='utf-8-sig',newline='') as f:
        w=csv.writer(f);w.writerow(['slide_number','candidate_id','reason','heuristic_score','object_count','object_keys'])
        for c in candidates:w.writerow([c['slide_number'],c['candidate_id'],c['reason'],c['heuristic_score'],c['object_count'],';'.join(c['object_keys'])])
    print(f'Candidates: {len(candidates)} | JSON: {jp} | CSV: {cp}')

if __name__=='__main__': main()
