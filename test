#!/usr/bin/env python3
"""CSIL Phase 3B: local semantic search + native editable deck builder.
Keep csil_assemble_deck_fixed.py in the same src directory. Uses no cloud services.
--build uses the unchanged Phase 2B embedding/index workflow.
"""
import argparse, hashlib, html, json, math, re, sys, urllib.request, urllib.error, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse, unquote

MODEL='embeddinggemma'
def clean(v):
    if v is None:return ''
    if isinstance(v,(dict,list)):return ' '.join(clean(x) for x in (v.values() if isinstance(v,dict) else v))
    return str(v)
def embed(text, model, timeout):
    data=json.dumps({'model':model,'input':text,'truncate':True,'keep_alive':'10m'}).encode()
    req=urllib.request.Request('http://127.0.0.1:11434/api/embed',data=data,headers={'Content-Type':'application/json'})
    with urllib.request.urlopen(req,timeout=timeout) as resp:result=json.load(resp)
    vec=result.get('embeddings',[None])[0]
    if not isinstance(vec,list) or not vec:raise RuntimeError('No embedding returned by Ollama')
    norm=math.sqrt(sum(x*x for x in vec))
    if not norm:raise RuntimeError('Zero-length embedding')
    return [round(x/norm,7) for x in vec]
def cosine(a,b):return sum(x*y for x,y in zip(a,b)) if len(a)==len(b) else -1

def collect(root):
    src=root/'ollama_classifications_smart'/'catalogue_ollama_enriched.json'
    if not src.exists():raise FileNotFoundError(f'Missing {src}. Run smart classifier --plan first.')
    obj=json.loads(src.read_text(encoding='utf-8-sig'))
    items=[]
    for a in obj['assets']:
        c=a.get('ollama_classification')
        if not isinstance(c,dict):continue
        aid=str(a.get('asset_id',''))
        if not re.fullmatch('[A-Za-z0-9_-]+',aid):continue
        if not (root/'previews'/f'{aid}.png').exists():continue
        item={'id':aid,'name':clean(c.get('asset_name')) or aid,
              'category':clean(a.get('asset_category') or a.get('asset_type')),
              'description':clean(c.get('description')),
              'visual':clean(c.get('visual_structure')),
              'intent':clean(c.get('communication_intent')),
              'framework':clean(c.get('consulting_framework')),
              'uses':clean(c.get('consulting_use_cases')),
              'keywords':clean(c.get('search_keywords')),
              'slide_text':clean(a.get('extracted_text'))[:1800],
              'pptx':(root/'assets'/f'{aid}.pptx').exists(),
              'confidence':c.get('confidence',None)}
        item['text']='\n'.join(f'{k}: {item[k]}' for k in ('name','category','description','visual','intent','framework','uses','keywords','slide_text') if item[k])[:5500]
        items.append(item)
    return items

def build(root,model,timeout):
    items=collect(root)
    dest=root/'semantic_search';dest.mkdir(exist_ok=True)
    cache_path=dest/'embedding_cache.json'
    cache=json.loads(cache_path.read_text(encoding='utf-8')) if cache_path.exists() else {}
    # Model key prevents accidental mixing of different embedding spaces.
    cache={k:v for k,v in cache.items() if isinstance(v,dict) and v.get('model')==model}
    failures=[];indexed=[];new=0
    for n,item in enumerate(items,1):
        key=item['id'];digest=hashlib.sha256(item['text'].encode()).hexdigest()
        prior=cache.get(key)
        if not prior or prior.get('digest')!=digest:
            try:
                vector=embed(item['text'],model,timeout)
                cache[key]={'model':model,'digest':digest,'vector':vector}
                new+=1
                if new%10==0:
                    cache_path.write_text(json.dumps(cache),encoding='utf-8')
                    print(f'Embedded {new} new assets ({n}/{len(items)})',flush=True)
            except Exception as e:
                failures.append((key,str(e)))
                print(f'ERROR {key}: {e}',file=sys.stderr)
                continue
        indexed.append({k:v for k,v in item.items() if k!='text'}|{'vector':cache[key]['vector']})
    cache_path.write_text(json.dumps(cache),encoding='utf-8')
    (dest/'index.json').write_text(json.dumps({'model':model,'items':indexed},ensure_ascii=False),encoding='utf-8')
    print(f'Indexed {len(indexed)} assets; new embeddings: {new}; failures: {len(failures)}')
    print(f'Index: {dest / "index.json"}')
    if failures:print('Failed IDs:',', '.join(x[0] for x in failures[:20]))

