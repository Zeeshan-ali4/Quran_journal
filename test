
$manifest = Get-ChildItem ".\output\*_manifest.json" | Select-Object -First 1
$candidates = Get-ChildItem ".\output\*_component_candidates.json" | Select-Object -First 1
$deck = Get-ChildItem ".\input\*.pptx" | Select-Object -First 1

if (!$manifest -or !$candidates -or !$deck) {
    Write-Host "Missing input deck, manifest, or candidates file."
} else {
    py .\src\extract_assets.py `
        $deck.FullName `
        $manifest.FullName `
        $candidates.FullName `
        --output ".\output\extracted_assets"
}
