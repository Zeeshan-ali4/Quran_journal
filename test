
$library = ".\output\asset_library"

Write-Host "PPTX assets:" (
    (Get-ChildItem "$library\assets" -Filter *.pptx).Count
)

Write-Host "PNG previews:" (
    (Get-ChildItem "$library\previews" -Filter *.png).Count
)

Write-Host "Catalogue records:" (
    (Import-Csv "$library\catalogue.csv").Count
)
